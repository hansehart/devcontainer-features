{
  "id": "codex",
  "version": "2.1.3",
  "name": "Codex CLI",
  "description": "Installs the OpenAI Codex CLI on a selectable channel.",
  "documentationURL": "https://github.com/hansehart/devcontainer-features/tree/main/src/codex",
  "options": {
    "version": {
      "type": "string",
      "default": "latest",
      "description": "Channel (latest) or an exact version (major.minor.patch)."
    },
    "stateDir": {
      "type": "string",
      "default": "",
      "description": "If set, puts this feature's data at this path, which must be inside the remote user's home. Mount a volume there to persist it across rebuilds."
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "openai.chatgpt"
      ]
    },
    "o3s": {
      "hosts": [
        {
          "name": "api.openai.com",
          "ports": [
            443
          ],
          "secret": "OPENAI_API_KEY",
          "description": "Model inference with an API key"
        },
        {
          "name": "chatgpt.com",
          "ports": [
            443
          ],
          "description": "Model inference with a subscription"
        },
        {
          "name": "auth.openai.com",
          "ports": [
            443
          ],
          "description": "Sign-in"
        }
      ],
      "files": [
        {
          "name": "config.toml",
          "target": "${stateDir}/config.toml",
          "description": "The agent's rules and integrations"
        }
      ]
    }
  },
  "postCreateCommand": "/usr/local/libexec/codex/init.sh"
}
